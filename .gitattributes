# ============================================================
# Git attributes — line ending and diff settings
# ============================================================

# Default: normalise all text files to LF in the repo
* text=auto eol=lf

# Explicitly text
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.env   text eol=lf
*.sh    text eol=lf
*.sql   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.txt   text eol=lf

# Explicitly binary — do not mangle these
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.pt    binary
*.pth   binary
*.bin   binary
*.onnx  binary
*.whl   binary

# Diff heuristics
*.py    diff=python
*.md    diff=markdown
