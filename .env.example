# ---------------------------------------------------------------------------
# Enterprise Procurement Intelligence — environment template
#
# Copy to `.env` and fill in what you need. Every value below is optional:
# with an empty `.env` the platform runs entirely on local providers (SQLite,
# on-disk vector index, SQLite property graph, in-memory cache, filesystem
# storage) and reports honestly that no language model is configured.
#
# Nothing secret belongs in the frontend. Only variables prefixed VITE_ are
# exposed to the browser bundle, and they are limited to the API base URL.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- application
APP_NAME="Enterprise Procurement Intelligence"
APP_ENV=development            # development | staging | production
API_PREFIX=/api/v1
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------- security
# REQUIRED IN PRODUCTION: set JWT_SECRET to a securely-generated random string
# of at least 32 characters. The application will refuse to start in production
# if this is set to the default or any other known-weak value.
#
#   Generate a safe secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# The default below is ONLY safe for local development (APP_ENV=development).
JWT_SECRET=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=720
REFRESH_TOKEN_TTL_MINUTES=10080
ALLOW_SELF_REGISTRATION=true
DEFAULT_TENANT_SLUG=acme-procurement
# Optional: create the first administrator on startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Rate limits (requests per window, per client).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN=20
RATE_LIMIT_UPLOAD=60
RATE_LIMIT_QUERY=120
RATE_LIMIT_MODEL=240

# ------------------------------------------------------------------ database
# Production: PostgreSQL + psycopg (async).
# DATABASE_URL=postgresql+psycopg://epi:epi@localhost:5432/epi
# Local development without Docker: SQLite (the default when unset).
DATABASE_URL=sqlite+aiosqlite:///./var/epi.db
AUTO_CREATE_SCHEMA=true        # production: false and run `alembic upgrade head`
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# -------------------------------------------------------------------- vector
# local = on-disk numpy index (no server required); qdrant = Qdrant service.
VECTOR_PROVIDER=local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_CHUNKS=procurement_chunks
QDRANT_COLLECTION_PAGES=document_pages
QDRANT_COLLECTION_TABLES=table_chunks
VECTOR_DIM=0                   # 0 = derive from the embedding provider

# --------------------------------------------------------------------- graph
# local = SQLite property graph (no server required); neo4j = Neo4j service.
GRAPH_PROVIDER=local
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4jdev          # neo4j 5.x rejects "neo4j" as the password; use a non-default value
NEO4J_DATABASE=neo4j

# --------------------------------------------------------------------- cache
# memory = in-process cache; redis = Redis service.
CACHE_PROVIDER=memory
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------- storage
# local = filesystem; s3 = S3/MinIO.
STORAGE_PROVIDER=local
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=epi-documents
# S3_REGION=us-east-1

# ----------------------------------------------------------------- reasoning
# Any OpenAI-compatible chat-completions endpoint (vLLM, TGI, Ollama, hosted
# providers). Leave blank to run in labelled extractive mode: answers are then
# composed from retrieved evidence and clearly marked as degraded.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
LLM_SMALL_MODEL=              # optional cheaper model for classification tasks
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# ---------------------------------------------------------------------- vision
# Used only for layout-sensitive pages selected by the pipeline, never for
# every page.
VISION_PROVIDER=openai_compatible
VLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
VLM_BASE_URL=                 # defaults to LLM_BASE_URL when blank
VLM_API_KEY=
VLM_ENABLED=true

# ----------------------------------------------------------------- embeddings
# bge-m3 is the intended production model; the smaller bge-small-en-v1.5 is a
# drop-in fallback for constrained machines.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto         # auto | cpu | cuda
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIM=0               # 0 = derive from the model
EMBEDDING_ALLOW_DOWNLOAD=true

# ------------------------------------------------------------------ reranking
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true
RERANKER_DEVICE=auto
# Report and use local providers when a production provider is unreachable.
ALLOW_PROVIDER_FALLBACK=true

# ---------------------------------------------------------------- retrieval
DENSE_TOP_K=50
SPARSE_TOP_K=50
FUSION_TOP_K=50
RRF_K=60
RERANK_TOP_N=15
CONTEXT_MAX_CHUNKS=12
CONTEXT_MAX_TOKENS=6000
MAX_AGENT_ITERATIONS=2
EVIDENCE_SUFFICIENCY_THRESHOLD=0.45
ENABLE_QUERY_REWRITE=false
ENABLE_MULTI_QUERY=false
ENABLE_HYDE=false

# ----------------------------------------------------------------- ingestion
MAX_UPLOAD_MB=100
ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx,.csv,.txt,.md,.png,.jpg,.jpeg
OCR_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=40
OCR_LANGUAGE=en
# Some Paddle CPU builds fail on the oneDNN/PIR path; keep false unless your
# build is known good.
OCR_USE_ONEDNN=false
CHUNK_TARGET_TOKENS=320
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=60
CONTEXTUAL_ENRICHMENT=true
VISION_ESCALATION_ENABLED=true
VISION_MIN_TABLE_COMPLEXITY=4
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_CONCURRENCY=2

# --------------------------------------------------------------- observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=epi-procurement
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACE_STORE_LIMIT=200

# ----------------------------------------------------------------------- data
EVALUATION_DIR=../data/evaluation
SYNTHETIC_DIR=../data/synthetic
SEED_CORPUS_DIR=../data/raw

# ------------------------------------------------------------------- frontend
# Only these are visible to the browser; never put a secret here.
VITE_API_BASE_URL=http://localhost:8000
